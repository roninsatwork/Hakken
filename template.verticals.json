{
  "version": 1,
  "alwaysKeep": [
    "base",
    "arcade"
  ],
  "verticals": {
    "movement": {
      "paths": [
        "src/app/(dashboard)/demos/**",
        "src/lib/movements/**",
        "src/lib/constants/avatars*",
        "src/movement-*.test.ts",
        "convex/movements*",
        "convex/utils/movementShapes.ts",
        "scripts/movement.mjs",
        "scripts/movement-debug/**",
        "e2e/movement-demo-smoke.spec.ts",
        "e2e/on-demand/movement-*.ts",
        "playwright.on-demand.config.ts",
        "public/models/**",
        "public/avatar.glb",
        "public/robot.glb",
        "docs/**/movement-*.md",
        "docs/**/temporary-posture-studio-demo.md",
        "docs/**/posture-*.md",
        "docs/**/replay-*.md",
        "docs/**/human-movement-*.md",
        "review/prompts/12-movement-scripts-cli.md",
        "src/lib/math/OneEuroFilter*"
      ],
      "dependencies": [
        "@mediapipe/tasks-vision",
        "@pixiv/three-vrm",
        "@react-three/drei",
        "@react-three/fiber",
        "@tensorflow-models/body-pix",
        "@tensorflow/tfjs-backend-webgl",
        "@tensorflow/tfjs-converter",
        "@tensorflow/tfjs-core",
        "kalidokit",
        "react-webcam"
      ],
      "scripts": [
        "*movement*"
      ],
      "messages": [],
      "routes": [
        "/demos/"
      ],
      "navLabels": [
        "postureStudio"
      ]
    },
    "properties": {
      "paths": [
        "src/app/(dashboard)/app/properties/**",
        "convex/properties*",
        "convex/propertyAgents*",
        "docs/**/property-research-and-reports.md"
      ],
      "dependencies": [],
      "scripts": [],
      "messages": [
        "properties"
      ],
      "routes": [
        "/app/properties"
      ],
      "navLabels": [
        "properties"
      ]
    },
    "salesReports": {
      "paths": [
        "src/app/(dashboard)/app/reports/**",
        "convex/salesReports*",
        "convex/salesReportActions*",
        "convex/salesReportContextService*",
        "docs/**/sales-and-board-reports.md"
      ],
      "dependencies": [],
      "scripts": [],
      "messages": [
        "salesReports"
      ],
      "routes": [
        "/app/reports"
      ],
      "navLabels": [
        "reports"
      ]
    },
    "salesData": {
      "paths": [
        "src/app/(dashboard)/app/sales-data/**",
        "src/app/(dashboard)/app/[workspace]/**",
        "src/lib/workspaceSlug*",
        "convex/salesData*",
        "convex/salesOpportunity*",
        "convex/utils/salesData*",
        "convex/utils/salesCustomerShapes.ts",
        "convex/utils/salesResearchShapes.ts",
        "docs/**/sales-data-workspace.md",
        "docs/**/workspace-sales-data-plan.md",
        "docs/**/workspace-customer-*.md",
        "docs/**/comax-*.md",
        "convex/utils/researchJobShapes.ts"
      ],
      "dependencies": [],
      "scripts": [],
      "messages": [
        "salesData"
      ],
      "routes": [
        "/app/sales-data",
        "/app/acme/"
      ],
      "navLabels": []
    }
  },
  "shared": [
    {
      "owners": [
        "movement",
        "properties",
        "salesReports",
        "salesData"
      ],
      "paths": [
        "src/app/(public)/_components/home/DemosIntro.tsx",
        "src/app/(public)/_components/home/ProductPanels.tsx"
      ]
    },
    {
      "owners": [
        "properties",
        "salesData"
      ],
      "paths": [
        "convex/bola.verticals.test.ts"
      ]
    }
  ]
}
