# Product requirements are declared in sonae.product.json.
# See docs/operator/product-setup.md; product:init generates product.env.example for a clone.
# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=anonymous:anonymous-test

NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211

# Public app URL used by production links and auth callbacks.
# SITE_URL=https://your-app.example.com
# Convex Auth signing keys are generated per deployment by its setup tooling.
# JWT_PRIVATE_KEY=
# JWKS=
# NEXT_PUBLIC_APP_URL=https://your-app.example.com

# Bootstrap and alert fallback.
# INITIAL_SUPER_ADMIN_EMAIL=admin@example.com

# Auth providers. Configure every provider selected in sonae.product.json.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Sonae <noreply@example.com>

# Runtime AI providers. Configure those selected in sonae.product.json.
# Knowledge, voice and telephony additionally require Vertex credentials.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OpenRouter is a gateway: one key reaches many vendors' models, and its
# catalogue is the only one that publishes prices, so those models arrive costed.
# OPENROUTER_API_KEY=

# Optional ingestion/integration providers.
# FIRECRAWL_API_KEY=
# APIFY_API_TOKEN=
# APIFY_WEBHOOK_SECRET=

# Error monitoring (Sentry). Off until the DSN is set — local dev needs none of
# these. Set the environment to "production" on the production deployment only;
# anything else reports as "development". The traces rate is a fraction (0–1)
# of requests to performance-trace; it is billed per event, so it defaults to 0.
# The last three are build-time only, for uploading source maps so stack traces
# are readable; without them errors still arrive, just minified.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Where the public site's "Talk to us" / "Contact" actions point. Set this to
# send enquiries to an external contact page (opens in a new tab). Leave unset
# and they fall back to the in-app /contact route.
NEXT_PUBLIC_CONTACT_URL=

# Shared between the Next server and the Convex deployment: signs the widget
# embed pass that createWidgetThread requires. Generate with: openssl rand -hex 32
# WIDGET_EMBED_SIGNING_SECRET=

# Voice sessions (optional): the voice relay in services/voice-relay.
# VOICE_RELAY_URL=                 # relay root or /live
# VOICE_RELAY_SECRET=

# Telephone agent (optional): Twilio credentials and call routing.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TELEPHONY_NUMBER_OWNERS=
# TELEPHONY_PUBLIC_URL=
# TELEPHONY_STATUS_PUBLIC_URL=
# TELEPHONY_STREAM_URL=            # relay /twilio endpoint
# TELEPHONY_MAX_CONCURRENT_CALLS=
# TELEPHONY_MAX_CALLS_PER_NUMBER_PER_HOUR=

# Alert recipients (optional): daily platform/analytics health emails.
# PLATFORM_ALERT_EMAIL=
# PLATFORM_ALERT_EMAILS=
# ANALYTICS_ALERT_EMAIL=
# ANALYTICS_ALERT_EMAILS=

# Gmail OAuth (all three together when selected; separate from Google sign-in).
# CONNECTOR_GOOGLE_CLIENT_ID=
# CONNECTOR_GOOGLE_CLIENT_SECRET=
# CONNECTOR_TOKEN_ENCRYPTION_KEY=

# Optional Stripe billing; disabled in sonae.billing.json. Backend secrets only.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
