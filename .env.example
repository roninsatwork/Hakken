# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=anonymous:anonymous-test

NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Public app URL used by production links and auth callbacks.
# NEXT_PUBLIC_APP_URL=https://your-app.example.com

# Bootstrap and alert fallback.
# INITIAL_SUPER_ADMIN_EMAIL=admin@example.com

# Auth providers. Configure at least one for production.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Optional OAuth providers. Each activates, and its login button appears, only
# when both of its variables are set (in the Convex dashboard for production).
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_LINKEDIN_ID=
# AUTH_LINKEDIN_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Sonae <noreply@example.com>

# Runtime AI providers. Configure at least one live provider for production.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OpenRouter is a gateway: one key reaches many vendors' models, and its
# catalogue is the only one that publishes prices, so those models arrive costed.
# OPENROUTER_API_KEY=

# Optional ingestion/integration providers.
# FIRECRAWL_API_KEY=
# APIFY_API_TOKEN=
# APIFY_WEBHOOK_SECRET=

# Where the public site's "Talk to us" / "Contact" actions point. Set this to
# send enquiries to an external contact page (opens in a new tab). Leave unset
# and they fall back to the in-app /contact route.
NEXT_PUBLIC_CONTACT_URL=
