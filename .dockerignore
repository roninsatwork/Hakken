Dockerfile
.dockerignore
node_modules
npm-debug.log
README.md
.next
.git
.env*.local

# The build needs src/, convex/, public/, config and package files — nothing
# below is reachable from `next build`, and together these were ~100MB of
# build-context upload on every deploy (maintenance plan M4.3).
docs
e2e
scripts/movement-debug
coverage
test-results
playwright-report
tmp
bespoke-installation
services
messages/*.orig
# Docker's plain * only matches the root; nested tests also depend on the
# development helpers excluded above, so remove tests at every depth.
**/*.test.ts
**/*.test.tsx
tsconfig.tsbuildinfo
.claude
.github
